# ----------------------------------------------------------------------
# htdocs/esia/.env
# ----------------------------------------------------------------------
# Окружение интеграции с ЕСИА.  Реальный .env лежит в .gitignore — НЕ
# коммитим его в публичный репозиторий.
#
# Заполняем после получения ответа Минцифры по запросу SCR#6142301.
# ----------------------------------------------------------------------

# Окружение: test (по умолчанию, до прохождения автотестов и одобрения
# заявки на ПРОД) или prod.
ESIA_ENV=test

# Хост ЕСИА.  Если ESIA_ENV выставлен — этот параметр опционален.
# ESIA_HOST=https://esia-portal1.test.gosuslugi.ru

# Мнемоника информационной системы (FORSAGE для ИС ERATRADE).
ESIA_CLIENT_ID=FORSAGE

# Не используется в OIDC v3 с подписью JWT — подпись делается СКЗИ.
# Оставляйте пустым.
ESIA_CLIENT_SECRET=

# Должен 1-в-1 совпадать с redirect_uri в Приложении Г, поданном Минцифре.
ESIA_REDIRECT_URI=https://eraetp.app/esia/callback.php

# Через пробел — список scope из формы (ровно те, что согласованы).
ESIA_SCOPES=openid fullname birthdate gender snils inn email mobile

# Подписание запросов:
#   sidecar   - локальный node.js на 127.0.0.1:8401 (см. signer-node/)
#   cryptopro - КриптоПро CSP через cryptcp/csptest
#   mock      - заглушка для unit-тестов (НЕ для ЕСИА)
ESIA_SIGNER_MODE=sidecar
ESIA_SIGNER_URL=http://127.0.0.1:8401

# Только для cryptopro: SHA1-thumbprint импортированного контейнера.
ESIA_CERT_THUMBPRINT=
ESIA_CERT_PASSWORD=

# Опционально: для openssl-gost backend сидекара
ESIA_CERT_PEM_PATH=
ESIA_KEY_PEM_PATH=

# Журнал взаимодействия (требование регламента — хранить 30 дней).
# Каталог logs/ должен быть доступен для записи и закрыт от веба .htaccess-ом.
ESIA_LOG_PATH=/home/site/htdocs/logs/esia.log

# Опционально: прокидывать nonce/sig верификацию id_token (на тесте можно 0).
ESIA_VERIFY_ID_TOKEN=0
ESIA_STATE_TTL=300
